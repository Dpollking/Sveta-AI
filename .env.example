APP_ENV=development
DATABASE_URL=sqlite:///./data/sveta.db

# ollama | llama_cpp | vllm — llama_cpp and vllm both speak the same
# OpenAI-compatible /v1/chat/completions API, so they also work against a
# real hosted provider (OpenRouter, Groq, Together, ...) if you don't have
# a local server: point LLM_BASE_URL at it and set LLM_API_KEY.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT=30
# Only needed for a real hosted API, not a local llama.cpp/vLLM server.
LLM_API_KEY=

RAG_ENABLED=true
RAG_PERSIST_DIR=./data/chroma
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

ADMIN_TOKEN=change-me
KNOWLEDGE_DIR=./knowledge
MEDIA_DIR=./media
